# Copia este archivo como .env y completa los valores.

# Cadena de conexión a PostgreSQL (16 o superior).
#   Supabase: Connect → Direct connection string → Direct connection → URI
#             (o "Session pooler" si tu red no tiene IPv6). Sustituye [YOUR-PASSWORD]
#             por la contraseña de la base de datos y NO añadas ?sslmode=… a la URI.
#   Local:    postgresql://USUARIO:CONTRASEÑA@localhost:5432/agenda
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxxxxxxxxxx.supabase.co:5432/postgres

# true para Supabase y otros proveedores en la nube (conexión cifrada); false en local.
DATABASE_SSL=true

# Puerto de la API. El frontend (Vite, puerto 5173) redirige /api a este puerto.
PORT=4000

# URL pública del frontend: enlaces de los emails y CORS (varias separadas por comas).
FRONTEND_URL=http://localhost:5173

# development | production. En producción la cookie de sesión exige HTTPS.
NODE_ENV=development

# Cookie de sesión: "lax" si frontend y API comparten dominio (recomendado);
# "none" sólo si están en dominios distintos (exige HTTPS).
COOKIE_SAME_SITE=lax

# Proxies de confianza para obtener la IP real (límites de intentos).
# "loopback" en local; 1 en Vercel o detrás de un proxy/balanceador.
TRUST_PROXY=loopback

# Conexiones máximas a PostgreSQL por instancia de la API (en Vercel, 5).
# DATABASE_POOL_MAX=10

# Sólo servidor local (npm run dev/start): cada cuántos minutos se ponen en cola los
# recordatorios de citas (0 = desactivado). En Vercel lo hace el cron de GitHub.
REMINDER_JOB_INTERVAL_MINUTES=5

# Secreto del cron de GitHub (POST /api/cron/run, ver .github/workflows/cron.yml).
# Mínimo 24 caracteres: openssl rand -hex 24. Sin él, la ruta del cron está desactivada.
# CRON_SECRET=

# Secreto compartido con el proxy del frontend en Vercel (middleware.ts), que reenvía la IP real
# de cada visitante. El mismo valor en los dos proyectos. Mínimo 24 caracteres.
# PROXY_SECRET=

# --- Emails (Gmail con OAuth2) -------------------------------------------------
# Sin estas variables la API funciona igual, pero los emails quedan en cola sin enviarse.
GMAIL_USER=
GMAIL_FROM_NAME=Agendo
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Fuera de producción TODOS los emails se envían a esta dirección (por defecto GMAIL_USER),
# con el destinatario original en el asunto, para no escribir a clientes de prueba.
# En producción se envían a su destinatario real. "off" desactiva la redirección.
# EMAIL_REDIRECT_TO=
