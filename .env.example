# Copia este archivo como .env y completa los valores.

# Cadena de conexión a PostgreSQL (16 o superior).
#   Supabase: Connect → Direct connection string → Direct connection → URI
#             (o "Session pooler" si tu red no tiene IPv6). Sustituye [YOUR-PASSWORD]
#             por la contraseña de la base de datos y NO añadas ?sslmode=… a la URI.
#   Local:    postgresql://USUARIO:CONTRASEÑA@localhost:5432/agenda
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxxxxxxxxxx.supabase.co:5432/postgres

# true para Supabase y otros proveedores en la nube (conexión cifrada); false en local.
DATABASE_SSL=true

# Puerto de la API. El frontend (Vite, puerto 5173) redirige /api a este puerto.
PORT=4000

# URL pública del frontend: enlaces de los emails y CORS (varias separadas por comas).
FRONTEND_URL=http://localhost:5173

# development | production. En producción la cookie de sesión exige HTTPS.
NODE_ENV=development

# Cookie de sesión: "lax" si frontend y API comparten dominio (recomendado);
# "none" sólo si están en dominios distintos (exige HTTPS).
COOKIE_SAME_SITE=lax

# Proxies de confianza para obtener la IP real (límites de intentos).
# "loopback" en local; 1 en Vercel o detrás de un proxy/balanceador.
TRUST_PROXY=loopback

# Conexiones máximas a PostgreSQL por instancia de la API (en Vercel, 5).
# DATABASE_POOL_MAX=10

# Sólo servidor local (npm run dev/start): cada cuántos minutos se ponen en cola los
# recordatorios de citas (0 = desactivado). En producción los envía el cron de GitHub
# (scripts/cron.ts), que se conecta directamente a la base y a Gmail, sin pasar por Vercel.
REMINDER_JOB_INTERVAL_MINUTES=5

# Sólo servidor local, con la base de este equipo (npm run dev:local): cada cuántos minutos se ponen en
# cola las invitaciones de calendario de las citas que entran en la ventana de 14 días, como el cron de
# GitHub (0 = desactivado). Nunca corre en la nube ni contra la base de producción.
# CALENDAR_INVITE_JOB_INTERVAL_MINUTES=10

# Secreto compartido con el proxy del frontend en Vercel (middleware.ts), que reenvía la IP real
# de cada visitante. El mismo valor en los dos proyectos. Mínimo 24 caracteres.
# PROXY_SECRET=

# --- Emails (Gmail con OAuth2) -------------------------------------------------
# Sin estas variables la API funciona igual, pero los emails quedan en cola sin enviarse.
GMAIL_USER=
GMAIL_FROM_NAME=Agenda360
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# smtp (por defecto) o api. Con api los emails salen por la API de Gmail y basta un refresh token
# con el permiso gmail.send (sólo enviar), en lugar de https://mail.google.com/ (todo el buzón).
# Ver README, «Emails».
# GMAIL_TRANSPORT=api

# Fuera de producción TODOS los emails se envían a esta dirección (por defecto GMAIL_USER),
# con el destinatario original en el asunto, para no escribir a clientes de prueba.
# En producción se envían a su destinatario real. "off" desactiva la redirección.
# EMAIL_REDIRECT_TO=

# Sólo para `npm run dev:local` (la base de este equipo): el correo al que van TODOS sus emails de
# prueba, también las invitaciones de calendario. Gana a EMAIL_REDIRECT_TO y a GMAIL_USER, y ningún otro
# arranque lo lee: así nunca desvía los emails de `npm run dev:prod` (la base de producción).
# LOCAL_TEST_INBOX=

# --- Archivos de la historia clínica (Supabase Storage) -------------------------
# Supabase → Project Settings → API Keys: la URL del proyecto y la clave secreta (service_role o
# sb_secret_…). NUNCA va en el frontend. El bucket privado se crea solo.
# Sin ellas: en local los archivos se guardan en storage/; en producción quedan desactivados.
# SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# STORAGE_BUCKET=historias-clinicas

# --- CAPTCHA de la página de reservas y del registro (Cloudflare Turnstile) -----
# dash.cloudflare.com → Turnstile → Add widget (hostname del frontend, modo Managed). Con las dos
# claves, reservar y registrarse exigen pasar el CAPTCHA (casi siempre invisible); si Cloudflare
# falla, se rechaza. Sin ellas no se pide (en producción, /api/health dice captcha: false).
# La Site Key es pública (la recibe el navegador); la Secret Key, no.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Otros dominios del frontend, separados por comas (ya valen los de FRONTEND_URL y APP_URL).
# TURNSTILE_HOSTNAMES=

# --- Cupo de Gmail, topes de emails y avisos -------------------------------------
# Envíos en 24 h de la cuenta de Gmail (por defecto 500; con Google Workspace, unos 2.000). Se mira al
# enviar, con tres niveles: el equipo (contraseñas, seguridad, planes) puede usar todo el cupo; el
# paciente, el cupo menos EMAIL_TEAM_RESERVE; las copias al profesional y los avisos al negocio, el
# cupo menos EMAIL_PATIENT_RESERVE. Lo que no cabe espera en la cola, sin perderse.
# EMAIL_DAILY_QUOTA=500
# EMAIL_TEAM_RESERVE=20
# EMAIL_PATIENT_RESERVE=100
# Tope de la base de datos del plan de Supabase, en MB (la tarjeta «Base de datos» de Salud del super
# admin; el plan gratuito tiene 500).
# DATABASE_LIMIT_MB=500
# Tope de los archivos de Supabase Storage, en MB (la pantalla «Base de datos» del super admin principal,
# spec 024; el plan gratuito tiene 1 GB, y los archivos no cuentan en la base).
# FILES_LIMIT_MB=1024
# Emails al paciente que provocan las reservas online y los registros en 24 h (por defecto 150): lo
# que pase de aquí no se envía (es una defensa contra las reservas falsas, spec 009).
# PUBLIC_EMAILS_PER_DAY=150
# Canal de ntfy para que la API avise al llegar al cupo o a un tope (el mismo del cron). Opcional: NTFY_SERVER.
# NTFY_TOPIC=

# --- Avisos en el celular (Web Push, spec 013) -----------------------------------
# Crea el par con `npm run push:keys` y pon aquí (y en Vercel, Lambda y GitHub) las dos líneas.
# Sin ellas la API funciona igual, sin avisos (/api/health dice "push": false). La privada es secreta.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Opcional: el contacto para los servicios de avisos (mailto: o https:).
# VAPID_SUBJECT=

# --- Copias de seguridad (scripts/backup.ts, workflow backup.yml) --------------
# Clave con la que se cifran las copias (mínimo 20 caracteres; genera una larga y aleatoria).
# La misma en GitHub → Secrets → BACKUP_PASSPHRASE. Sin ella las copias no se pueden abrir.
# BACKUP_PASSPHRASE=
# Quién recibe las copias por email (en GitHub es una variable: BACKUP_EMAIL).
# BACKUP_EMAIL=
